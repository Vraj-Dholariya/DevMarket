<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex flex-col min-h-screen">
  <%- include('partials/navbar') %>

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold mb-8">Welcome back, <%= user.name %>!</h1>

      <%- include('partials/messages') %>

      <!-- Quick Stats -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">My Projects</h3>
          <p class="text-3xl font-bold text-primary-600"><%= myProjects.length %></p>
        </div>
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Saved Projects</h3>
          <p class="text-3xl font-bold text-blue-600"><%= bookmarks.length %></p>
        </div>
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Join Requests</h3>
          <p class="text-3xl font-bold text-yellow-600"><%= joinRequestCount %></p>
        </div>
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Notifications</h3>
          <p class="text-3xl font-bold text-red-600"><%= notifications.length %></p>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card mb-8">
        <h2 class="text-2xl font-semibold mb-4">Quick Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/projects/create/new" class="btn btn-primary text-center">
            Create New Project
          </a>
          <a href="/projects" class="btn btn-secondary text-center">
            Browse Projects
          </a>
          <a href="/profile" class="btn btn-secondary text-center">
            Edit Profile
          </a>
        </div>
      </div>

      <!-- Notifications -->
      <% if (notifications.length > 0) { %>
        <div class="card mb-8">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-semibold">Recent Notifications</h2>
            <a href="/notifications" class="text-primary-600 hover:text-primary-700">View All</a>
          </div>
          <div class="space-y-3">
            <% notifications.forEach(notification => { %>
              <div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg flex justify-between items-center">
                <div>
                  <p><%= notification.message %></p>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                    <%= new Date(notification.createdAt).toLocaleString() %>
                  </p>
                </div>
                <% if (notification.link) { %>
                  <a href="<%= notification.link %>" class="btn btn-primary">View</a>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- My Projects -->
      <div class="card mb-8">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-2xl font-semibold">My Projects</h2>
          <a href="/my-projects" class="text-primary-600 hover:text-primary-700">View All</a>
        </div>
        <% if (myProjects.length === 0) { %>
          <p class="text-gray-500 dark:text-gray-400 text-center py-8">
            You haven't created any projects yet.
            <a href="/projects/create/new" class="text-primary-600 hover:text-primary-700">Create one now</a>
          </p>
        <% } else { %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% myProjects.forEach(project => { %>
              <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:shadow-lg transition">
                <h3 class="text-lg font-semibold mb-2">
                  <a href="/projects/<%= project._id %>" class="hover:text-primary-600"><%= project.title %></a>
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2 line-clamp-2"><%= project.description %></p>
                <div class="flex justify-between items-center">
                  <span class="badge badge-primary"><%= project.status %></span>
                  <a href="/projects/<%= project._id %>" class="text-sm text-primary-600 hover:text-primary-700">View →</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Saved Projects -->
      <% if (bookmarks.length > 0) { %>
        <div class="card">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-semibold">Saved Projects</h2>
            <a href="/saved-projects" class="text-primary-600 hover:text-primary-700">View All</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% bookmarks.forEach(project => { %>
              <div class="p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:shadow-lg transition">
                <h3 class="text-lg font-semibold mb-2">
                  <a href="/projects/<%= project._id %>" class="hover:text-primary-600"><%= project.title %></a>
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2 line-clamp-2"><%= project.description %></p>
                <a href="/projects/<%= project._id %>" class="text-sm text-primary-600 hover:text-primary-700">View Details →</a>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
