<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex flex-col min-h-screen">
  <%- include('partials/navbar') %>

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold mb-8 text-red-600">Admin Dashboard</h1>

      <%- include('partials/messages') %>

      <!-- Statistics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Total Users</h3>
          <p class="text-4xl font-bold text-primary-600"><%= stats.totalUsers %></p>
        </div>
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Total Projects</h3>
          <p class="text-4xl font-bold text-blue-600"><%= stats.totalProjects %></p>
        </div>
        <div class="card">
          <h3 class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">Active Projects</h3>
          <p class="text-4xl font-bold text-green-600"><%= stats.activeProjects %></p>
        </div>
      </div>

      <!-- Recent Users -->
      <div class="card mb-8">
        <h2 class="text-2xl font-semibold mb-4">Recent Users</h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <th class="text-left py-3 px-4">Name</th>
                <th class="text-left py-3 px-4">Email</th>
                <th class="text-left py-3 px-4">Joined</th>
                <th class="text-left py-3 px-4">Admin</th>
                <th class="text-left py-3 px-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% recentUsers.forEach(usr => { %>
                <tr class="border-b border-gray-200 dark:border-gray-700">
                  <td class="py-3 px-4"><%= usr.name %></td>
                  <td class="py-3 px-4"><%= usr.email %></td>
                  <td class="py-3 px-4"><%= new Date(usr.createdAt).toLocaleDateString() %></td>
                  <td class="py-3 px-4">
                    <% if (usr.isAdmin) { %>
                      <span class="badge badge-danger">Yes</span>
                    <% } else { %>
                      <span class="badge badge-secondary">No</span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4">
                    <div class="flex gap-2">
                      <a href="/portfolio/<%= usr._id %>" class="text-primary-600 hover:text-primary-700">View</a>
                      <% if (!usr.isAdmin) { %>
                        <form action="/admin/users/<%= usr._id %>/delete" method="POST" onsubmit="return confirmDelete('Are you sure you want to delete this user and all their projects?')" class="inline">
                          <button type="submit" class="text-red-600 hover:text-red-700">Delete</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Projects -->
      <div class="card">
        <h2 class="text-2xl font-semibold mb-4">Recent Projects</h2>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <th class="text-left py-3 px-4">Title</th>
                <th class="text-left py-3 px-4">Owner</th>
                <th class="text-left py-3 px-4">Category</th>
                <th class="text-left py-3 px-4">Status</th>
                <th class="text-left py-3 px-4">Created</th>
                <th class="text-left py-3 px-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% recentProjects.forEach(proj => { %>
                <tr class="border-b border-gray-200 dark:border-gray-700">
                  <td class="py-3 px-4"><%= proj.title %></td>
                  <td class="py-3 px-4"><%= proj.owner.name %></td>
                  <td class="py-3 px-4"><%= proj.category %></td>
                  <td class="py-3 px-4">
                    <span class="badge badge-<%= proj.status === 'Open' ? 'success' : proj.status === 'In Progress' ? 'warning' : 'secondary' %>">
                      <%= proj.status %>
                    </span>
                  </td>
                  <td class="py-3 px-4"><%= new Date(proj.createdAt).toLocaleDateString() %></td>
                  <td class="py-3 px-4">
                    <div class="flex gap-2">
                      <a href="/projects/<%= proj._id %>" class="text-primary-600 hover:text-primary-700">View</a>
                      <form action="/admin/projects/<%= proj._id %>/delete" method="POST" onsubmit="return confirmDelete('Are you sure you want to delete this project?')" class="inline">
                        <button type="submit" class="text-red-600 hover:text-red-700">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
