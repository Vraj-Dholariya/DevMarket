<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex flex-col min-h-screen">
  <%- include('partials/navbar') %>

  <main class="flex-1 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold mb-8">Edit Project</h1>

      <%- include('partials/messages') %>

      <form action="/projects/<%= project._id %>" method="POST" class="card space-y-6">
        <div>
          <label for="title" class="block text-sm font-medium mb-2">Project Title *</label>
          <input type="text" id="title" name="title" required class="input" value="<%= project.title %>">
        </div>

        <div>
          <label for="description" class="block text-sm font-medium mb-2">Description *</label>
          <textarea id="description" name="description" required rows="5" class="input"><%= project.description %></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label for="category" class="block text-sm font-medium mb-2">Category *</label>
            <select id="category" name="category" required class="input">
              <option value="Web Development" <%= project.category === 'Web Development' ? 'selected' : '' %>>Web Development</option>
              <option value="Mobile App" <%= project.category === 'Mobile App' ? 'selected' : '' %>>Mobile App</option>
              <option value="Machine Learning" <%= project.category === 'Machine Learning' ? 'selected' : '' %>>Machine Learning</option>
              <option value="Data Science" <%= project.category === 'Data Science' ? 'selected' : '' %>>Data Science</option>
              <option value="Game Development" <%= project.category === 'Game Development' ? 'selected' : '' %>>Game Development</option>
              <option value="IoT" <%= project.category === 'IoT' ? 'selected' : '' %>>IoT</option>
              <option value="Other" <%= project.category === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>

          <div>
            <label for="difficulty" class="block text-sm font-medium mb-2">Difficulty Level *</label>
            <select id="difficulty" name="difficulty" required class="input">
              <option value="Beginner" <%= project.difficulty === 'Beginner' ? 'selected' : '' %>>Beginner</option>
              <option value="Intermediate" <%= project.difficulty === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
              <option value="Advanced" <%= project.difficulty === 'Advanced' ? 'selected' : '' %>>Advanced</option>
            </select>
          </div>

          <div>
            <label for="status" class="block text-sm font-medium mb-2">Status</label>
            <select id="status" name="status" class="input">
              <option value="Open" <%= project.status === 'Open' ? 'selected' : '' %>>Open</option>
              <option value="In Progress" <%= project.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
              <option value="Completed" <%= project.status === 'Completed' ? 'selected' : '' %>>Completed</option>
              <option value="Closed" <%= project.status === 'Closed' ? 'selected' : '' %>>Closed</option>
            </select>
          </div>
        </div>

        <div>
          <label for="technologies" class="block text-sm font-medium mb-2">Technologies</label>
          <input type="text" id="technologies" name="technologies" class="input" value="<%= project.technologies.join(', ') %>">
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Separate technologies with commas</p>
        </div>

        <div>
          <label for="requiredSkills" class="block text-sm font-medium mb-2">Required Skills</label>
          <input type="text" id="requiredSkills" name="requiredSkills" class="input" value="<%= project.requiredSkills.join(', ') %>">
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Separate skills with commas</p>
        </div>

        <div>
          <label for="maxTeamSize" class="block text-sm font-medium mb-2">Maximum Team Size</label>
          <input type="number" id="maxTeamSize" name="maxTeamSize" min="1" max="20" value="<%= project.maxTeamSize %>" class="input">
        </div>

        <!-- Milestones Section -->
        <div>
          <label class="block text-sm font-medium mb-2">Project Milestones</label>
          <div id="milestonesContainer" class="space-y-2 mb-3">
            <% if (project.milestones && project.milestones.length > 0) { %>
              <% project.milestones.forEach((milestone, index) => { %>
                <div class="flex gap-2 items-center">
                  <input 
                    type="text" 
                    name="milestones[]" 
                    class="input flex-1" 
                    value="<%= milestone.title %>"
                    placeholder="Milestone <%= index + 1 %>"
                    required
                  >
                  <button 
                    type="button" 
                    onclick="this.parentElement.remove()" 
                    class="btn btn-danger btn-sm"
                  >
                    Remove
                  </button>
                </div>
              <% }) %>
            <% } %>
          </div>
          <button type="button" onclick="addMilestone()" class="btn btn-secondary btn-sm">
            + Add Milestone
          </button>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Manage your project milestones. <a href="/projects/<%= project._id %>/progress" class="text-primary-600 hover:underline">View progress tracker</a></p>
        </div>

        <div class="flex gap-4">
          <button type="submit" class="btn btn-primary">Update Project</button>
          <a href="/projects/<%= project._id %>" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script>
    let milestoneCount = <%= project.milestones ? project.milestones.length : 0 %>;

    function addMilestone() {
      const container = document.getElementById('milestonesContainer');
      const milestoneDiv = document.createElement('div');
      milestoneDiv.className = 'flex gap-2 items-center';
      milestoneDiv.innerHTML = `
        <input 
          type="text" 
          name="milestones[]" 
          class="input flex-1" 
          placeholder="Milestone ${milestoneCount + 1}: e.g., Complete API integration"
          required
        >
        <button 
          type="button" 
          onclick="this.parentElement.remove()" 
          class="btn btn-danger btn-sm"
        >
          Remove
        </button>
      `;
      container.appendChild(milestoneDiv);
      milestoneCount++;
    }
  </script>
</body>
</html>
