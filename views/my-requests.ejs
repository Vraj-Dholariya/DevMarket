<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex flex-col min-h-screen">
  <%- include('partials/navbar') %>

  <main class="flex-1 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold mb-8">My Join Requests</h1>

      <%- include('partials/messages') %>

      <% if (requests.length === 0) { %>
        <div class="card text-center py-16">
          <p class="text-gray-500 dark:text-gray-400 text-lg mb-4">You haven't sent any join requests yet.</p>
          <a href="/projects" class="btn btn-primary">Browse Projects</a>
        </div>
      <% } else { %>
        <div class="space-y-6">
          <% requests.forEach(request => { %>
            <% if (request.project) { %>
              <div class="card">
                <div class="flex justify-between items-start mb-4">
                  <div class="flex-1">
                    <h3 class="text-2xl font-semibold mb-2">
                      <a href="/projects/<%= request.project._id %>" class="hover:text-primary-600">
                        <%= request.project.title %>
                      </a>
                    </h3>
                    <p class="text-gray-600 dark:text-gray-400">
                      by <%= request.project.owner ? request.project.owner.name : 'Unknown' %> · Sent <%= new Date(request.createdAt).toLocaleDateString() %>
                    </p>
                  </div>
                  <span class="badge badge-<%= request.status === 'Pending' ? 'warning' : request.status === 'Accepted' ? 'success' : 'danger' %>">
                    <%= request.status %>
                  </span>
                </div>

                <% if (request.message) { %>
                  <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg mb-4">
                    <p class="text-sm font-medium mb-1">Your message:</p>
                    <p class="text-gray-700 dark:text-gray-300"><%= request.message %></p>
                  </div>
                <% } %>

                <div class="flex gap-3">
                  <a href="/projects/<%= request.project._id %>" class="btn btn-primary">View Project</a>
                  <% if (request.status === 'Accepted') { %>
                    <a href="/projects/<%= request.project._id %>/progress" class="btn btn-success">View Progress</a>
                  <% } %>
                </div>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
